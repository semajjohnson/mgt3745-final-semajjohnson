{
  "name": "mgt3745-final",
  "private": true,
  "type": "module",
  "description": "The Pool: tracks kept with the name of the person they came from",
  "scripts": {
    "db:create": "wrangler d1 create mgt3745-entries",
    "db:schema": "wrangler d1 execute mgt3745-entries --remote --file=schema.sql",
    "db:export": "wrangler d1 export mgt3745-entries --remote --output=backup.sql",
    "dev": "wrangler dev --config worker/wrangler.toml",
    "deploy": "wrangler deploy --config worker/wrangler.toml",
    "test": "node --test \"evals/**/*.test.js\"",
    "test:proxy": "node --test \"worker/test/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "4.160.0"
  }
}
